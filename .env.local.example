# Copie este arquivo para .env.local (desenvolvimento) e preencha com valores reais.
# Em produção, configure as mesmas variáveis no painel da Netlify — nunca neste arquivo.
# Nenhum valor real deve ser commitado no repositório (.env.local já está no .gitignore).

# Supabase (Etapa 7/9) — projeto ainda precisa ser criado (pendência já registrada
# no checklist da Etapa 7).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# API de IA (Anthropic) — integração real já implementada (Etapa 10).
# Sem esta chave, o endpoint de análise responde 503 (integração não configurada).
ANTHROPIC_API_KEY=

# E-mail transacional (Brevo) — integração real já implementada (Etapa 10).
# Sem estas chaves, a notificação de novo lead é apenas registrada em log, sem
# impedir a criação da solicitação (Etapa 4: falha de notificação nunca bloqueia
# o lead).
BREVO_API_KEY=
BREVO_DESTINATARIO_NOTIFICACAO=

# URL pública do site — usada para montar links absolutos (ex.: no e-mail de notificação).
SITE_URL=http://localhost:3000
